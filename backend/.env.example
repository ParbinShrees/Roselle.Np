# Roselle Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.

# ─── Gmail SMTP ──────────────────────────────────────────────────────────────
# The Gmail address that will SEND the emails.
GMAIL_USER=parbinshreesh64487@gmail.com

# A Gmail App Password — NOT your regular Gmail password.
# How to generate one:
#   1. Go to myaccount.google.com → Security
#   2. Enable 2-Step Verification (required)
#   3. Go to Security → App Passwords
#   4. Select "Mail" as the app, generate, and paste the 16-char password below.
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
